<Page
    x:Class="JellyfinPlayer.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Background="#101517">
            <TextBox x:Name="QueryBox" PlaceholderText="Search movies, series, episodes" KeyDown="QueryBox_KeyDown" Margin="16,10,16,0"/>
            <TextBlock x:Name="ErrorText" Foreground="#FF8A80" TextWrapping="Wrap" Margin="16,4,16,0"/>
            <TextBlock x:Name="EmptyText" Text="Type and press Enter to search." Opacity="0.7" Margin="16,4,16,10"/>
        </StackPanel>

        <ListView x:Name="ResultsList" Grid.Row="1" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Result_Click">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="60" Height="90" Background="#20262B">
                            <Image Source="{Binding Poster}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="13" Opacity="0.7" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
