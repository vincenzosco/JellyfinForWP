<Page
    x:Class="JellyfinPlayer.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <Grid>
        <MediaElement x:Name="MediaEl" Stretch="Uniform" MediaOpened="Media_Opened" MediaEnded="Media_Ended" MediaFailed="Media_Failed"/>

        <StackPanel VerticalAlignment="Top" Margin="16,10">
            <TextBlock x:Name="TitleText" Foreground="White" FontSize="18" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,16">
            <TextBlock x:Name="ErrorText" Foreground="#FF8A80" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PlayPauseButton" Content="Pause" Click="PlayPause_Click"/>
                <Button x:Name="DirectButton" Content="Play direct" Click="Direct_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
                <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" Margin="8,0,0,0"/>
                <ProgressRing x:Name="Busy" IsActive="False" Height="32" Width="32" Margin="8,0,0,0"/>
            </StackPanel>
            <Slider x:Name="SeekSlider" Minimum="0" Maximum="100" ValueChanged="Seek_Changed" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Page>
