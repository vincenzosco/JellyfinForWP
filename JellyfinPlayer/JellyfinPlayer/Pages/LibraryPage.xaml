<Page
    x:Class="JellyfinPlayer.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#101517">
            <TextBlock x:Name="TitleText" FontSize="24" Foreground="White" Margin="16,10,0,10"/>
            <TextBlock x:Name="ErrorText" Foreground="#D9534F" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
        </Grid>

        <Grid Grid.Row="1">
            <GridView x:Name="ItemsGrid" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Item_Click" Padding="6">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="150" Height="205" Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="150"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#20262B">
                                <Image Source="{Binding Poster}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"/>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ProgressRing x:Name="Busy" IsActive="False" Height="40" Width="40"/>
            <Button x:Name="LoadMoreButton" x:Uid="LoadMoreButton" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed" Click="LoadMore_Click"/>
        </Grid>
    </Grid>
</Page>
