<Page
    x:Class="JellyfinPlayer.ItemDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Margin="16,12">
            <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" Foreground="#00A4DC" TextWrapping="Wrap"/>
            <TextBlock x:Name="MetaText" Opacity="0.7" Margin="0,2,0,8" TextWrapping="Wrap"/>

            <Grid Height="200" Margin="0,4,0,8">
                <Border Background="#20262B">
                    <Image x:Name="BackdropImage" Stretch="UniformToFill"/>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="PlayButton" Content="Play" Click="Play_Click" Background="#00A4DC" Foreground="White"/>
                <ToggleButton x:Name="FavoriteToggle" Content="Favorite" Click="Favorite_Click" Margin="8,0,0,0"/>
                <ToggleButton x:Name="PlayedToggle" Content="Watched" Click="Played_Click" Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#D9534F" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="OverviewText" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
